{
  "expo": {
    "name": "G² Brothers CRM",
    "slug": "estatecrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020912"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.g2brothers.crm",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow G² Brothers CRM to securely authenticate field executives using Face ID"
      }
    },
    "android": {
      "package": "com.g2brothers.crm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020912"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#020912",
      "androidMode": "default"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D4ED8"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow G² Brothers CRM to securely authenticate field executives using Face ID"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "981d82a0-0a25-4082-bf5f-a1c77d0bb5fe"
      }
    }
  }
}
